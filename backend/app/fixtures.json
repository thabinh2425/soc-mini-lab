  "trainingCases": [
    {
      "id": "ssh-brute-force",
      "shortTitle": "SSH Brute Force",
      "title": "Case 01 — SSH Brute Force",
      "difficulty": "Intermediate",
      "category": "Identity & Access",
      "estimatedMinutes": 12,
      "description": "Investigate repeated SSH failures that culminate in a successful privileged login.",
      "objective": "Identify the attacking IP, determine impact, and choose the correct containment action.",
      "questions": [
        {
          "id": "ssh-q1",
          "prompt": "Which source is responsible for the attack?",
          "options": [
            "203.0.113.42",
            "198.51.100.77",
            "10.20.4.18"
          ],
          "correctOption": "203.0.113.42",
          "rationale": "The authentication logs consistently identify 203.0.113.42."
        },
        {
          "id": "ssh-q2",
          "prompt": "What makes this incident critical?",
          "options": [
            "The firewall blocked a packet",
            "A privileged login succeeded",
            "Only two passwords failed"
          ],
          "correctOption": "A privileged login succeeded",
          "rationale": "A successful root login after repeated failures suggests account compromise."
        },
        {
          "id": "ssh-q3",
          "prompt": "Best immediate containment?",
          "options": [
            "Block the source and rotate credentials",
            "Delete all server logs",
            "Disable the firewall"
          ],
          "correctOption": "Block the source and rotate credentials",
          "rationale": "This contains access while invalidating potentially compromised credentials."
        }
      ]
    },
    {
      "id": "suspicious-powershell",
      "shortTitle": "Suspicious PowerShell",
      "title": "Case 02 — Suspicious PowerShell",
      "difficulty": "Intermediate",
      "category": "Endpoint",
      "estimatedMinutes": 15,
      "description": "Analyze an encoded PowerShell process and a subsequent security-control change.",
      "objective": "Recognize suspicious execution and select an evidence-preserving response.",
      "questions": [
        {
          "id": "ps-q1",
          "prompt": "Which flag most strongly signals obfuscation?",
          "options": [
            "-EncodedCommand",
            "-NoProfile",
            "-Command"
          ],
          "correctOption": "-EncodedCommand",
          "rationale": "EncodedCommand commonly hides command content from casual inspection."
        },
        {
          "id": "ps-q2",
          "prompt": "Which follow-on action increased risk?",
          "options": [
            "Adding a Defender exclusion",
            "Opening Event Viewer",
            "Reading a text file"
          ],
          "correctOption": "Adding a Defender exclusion",
          "rationale": "The exclusion weakens endpoint protection in a writable directory."
        },
        {
          "id": "ps-q3",
          "prompt": "Best next step?",
          "options": [
            "Isolate host and preserve evidence",
            "Reboot and erase logs",
            "Ignore because PowerShell is signed"
          ],
          "correctOption": "Isolate host and preserve evidence",
          "rationale": "Isolation limits impact while preserving artifacts for investigation."
        }
      ]
    },
